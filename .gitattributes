# Normalise line endings so that shell scripts work identically on
# Windows checkouts (which would otherwise get CRLF and break bash).
* text=auto eol=lf

# Shell scripts MUST always use LF line endings.
*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf

# Binary files - never touch them.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
